{# Load in global macros for use across all Twig templates #}
{% import '_macros/globalMacros' as gMacros %}

{% set image = entry.imageAsset.eagerly().one() %}
{% set currentAspect = 'auto' %}
{% set xFormWidth = '' %}
{% set xFormHeight = '' %}
{% set aspectClasses = [] %}

{% set imgClasses = ['block', 'w-full'] %}
{% set aspectValues =  {
	'df': {'minSize': 0, 'aspect': 'auto'},
	'xs': {'minSize': 320, 'aspect': null},
	'sm': {'minSize': 640, 'aspect': null},
	'md': {'minSize': 768, 'aspect': null},
	'lg': {'minSize': 1024, 'aspect': null},
	'xl': {'minSize': 1280, 'aspect': null},
	'2xl': {'minSize': 1536, 'aspect': null},	
} %}
 
{% for key,value in aspectValues %}
	{% set subField = key|capitalize %}
	{% if entry.artDirection['aspect' ~ subField] != '' %}
		{% set aspectValues = aspectValues|merge({ (key) : value|merge({'aspect': entry.artDirection['aspect' ~ subField].value}) }) %}
	{% endif %}
{% endfor %}

{% for key,value in aspectValues %}
	{% if value.aspect != null %}
		{% set currentAspect = value.aspect %}
	{% endif %}
	{% if key == 'df' %}
		{% set sizeKey = '' %}
	{% else %}
		{% set sizeKey = key ~ ':' %}
	{% endif %}
	{% set aspectClasses = aspectClasses|merge([sizeKey ~ 'aspect-' ~ currentAspect]) %}
{% endfor %}

<picture class="">	
		
	{# loop through and write in src elements for different breakpoints #}
	
	{% for key, value in aspectValues|reverse %}
		
		{% if value.aspect != null %}
			{% if value.aspect == 'auto' %}
				{% set xForm = 'contentImage' %}				
			{% else %}
				{% set xForm = 'image-' ~ value.aspect %}				
			{% endif %}
			{% set transformedImages = craft.imagerx.transformImage(image, xForm) %}
			{% if key == 'df' %}
				{% if value.aspect == 'auto' %}				
					{% set xFormWidth = image.width %}
					{% set xFormHeight = image.height %}
				{% else %}				
					{% if value.aspect == 'video' %}
						{% set numerator = 16 %}
						{% set denominator = 9 %} 
					{% elseif value.aspect == 'square' %}
						{% set numerator = 1 %}
						{% set denominator = 1 %} 
					{% else %}
						{% set numerator = value.aspect|split('/')|first %}
						{% set denominator = value.aspect|split('/')|last %}        
					{% endif %}
					{% set xFormWidth = image.width %}				
					{% set xFormHeight = (image.width * denominator) / numerator %}				
				{% endif %}
				
				<img src="{{ craft.imager.placeholder({width: xFormWidth, height: xFormHeight}) }}"
					width="{{xFormWidth}}"
					height="{{xFormHeight}}"
					{% if not entry.lazyLoadImg %}        
						fetchpriority="high"
						sizes="{{gMacros.sizesAttr(sizeTracker, entry.artDirection)}}"
					{% else %}
						sizes="auto"     
					{% endif %}    
					srcset="{{ craft.imager.srcset(transformedImages) }}"
					alt="{{ entry.altText }}"
					class="block w-full{{aspectClasses|join(' ')}}"
					loading="{{entry.lazyLoadImg ? 'lazy' : 'eager'}}"
					decoding="async"
				>
			{% else %}
				<source sizes="auto" media="(min-width: {{value.minSize}}px)" srcset="{{ craft.imager.srcset(transformedImages) }}" {% if craft.imager.serverSupportsWebp() %}type="image/webp"{% endif %}>
			{% endif %}
		{% endif %}
	
	{% endfor %}
</picture>

