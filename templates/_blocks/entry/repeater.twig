{# Tilt Boilermaker - Repeater Template #}
{% import '_macros/globalMacros' as gMacros %}

{# Set block id, type, color scheme, class list #}
{% set blockId = entry.customId ? entry.customId|replace({' ': '-'})|trim : 'repeater-' ~ entry.id %}
{% set blockClass = entry.type.handle|kebab %}
{% set colorScheme = entry.colorScheme.class ?? colorScheme ?? "color-theme-default" %}
{% set repeaterClassList = entry.bgColor|length ? [colorScheme, 'bg-' ~ entry.bgColor] : [colorScheme] %}

{# get order setting from field and match to appropriate parameter syntax #}
{%
  set orderOptions = {
	'dd' : 'postDate desc',
	'da' : 'postDate asc',
	'r'  : 'RAND()',
	'az' : 'title asc',
	'za' : 'title desc',
	'cp' : '',
  }
%}
{% set listOrder = orderOptions[entry.listOrder.value] %}

{# Set variables for list display type and content type #}
{% set contentType = entry.repeaterContent %}
{% set displayType = contentType == 'navList' ? entry.navListDisplayType : entry.repeaterDisplay %}

{# set variables to handle situations where control/display settings aren't compatible with list type #}

{# Determine whether to use pagination or not #}
{% set paginateItems = false %}
{% if contentType != 'navList' and displayType not in ['buttonList', 'largeSlider', 'multiCardSlider'] and entry.itemsPerPage != 0 %}
	{% set paginateItems = true %}
{% endif %}

{# don't show dates on nav lists #}
{% set showDate = contentType not in ['navList', 'contentCards', 'linkCards'] and entry.showPostDate %}

{# always show excerpts on content cards #}
{% set showExcerpt = contentType == 'contentCards' ? true : entry.showExcerpt %}

{# get Row Size Settings for Card Lists #}
{% set cardRowDefaults = {'cardList': gSettings.cprCard, 'cardListSideImage': gSettings.cprCardSmImg, 'cardListTopImage': gSettings.cprCardLgImg} %}
{% set cardRowSizes = entry.cardsPerRow|length ? entry.cardsPerRow : (cardRowDefaults[displayType] ?? null) %}

{# get card counts for layout sizes for multi card slider #}
{% set cardSliderSizes = entry.cardsPerSizeSlider|length ? entry.cardsPerSizeSlider : gSettings.cardsPerSizeSlider %}

{# Set Aspect Setting for Images if Large Repeater is Display Type #}
{% if displayType == 'largeSlider' %}
	{% set slideImgAspectSm = entry.sliderSizeSm != '' ? entry.sliderSizeSm : gSettings.thumbAspectLg %}
	{% set slideImgAspectLg = entry.sliderSizeLg != '' ? entry.sliderSizeLg : gSettings.thumbAspectSm %}
{% endif %}

{# Gather list Content #}
{% set listContent = [] %}
{% set listData = [] %}
{% set imgWith = ['seoImage', 'headerImgSm', 'headerImg', 'imageAsset'] %}

{% switch contentType %}
	{% case "contentCards" %}
		{% set query = entry.contentCards.orderBy(listOrder).with(['imageAsset']) %}
		{% if paginateItems %}
			{% paginate query.limit(entry.itemsPerPage) as pageInfo, listData %}
			{% do seomatic.helper.paginate(pageInfo) %}
		{% else %}
			{% set listData = query.eagerly().all() %}
		{% endif %}
		
	{% case "linkCards" %}
		{% set query = entry.linkCards.orderBy(listOrder).with(['imageAsset']) %}
		{% if paginateItems %}
			{% paginate query.limit(entry.itemsPerPage) as pageInfo, listData %}
			{% do seomatic.helper.paginate(pageInfo) %}
		{% else %}
			{% set listData = query.eagerly().all() %}
		{% endif %}
	
	{% case "allInSection" %}
		{% set query = craft.entries().sectionId(entry.sectionToList).orderBy(listOrder).with(imgWith) %}
		{% if paginateItems %}
			{% paginate query.limit(entry.itemsPerPage) as pageInfo, listData %}
			{% do seomatic.helper.paginate(pageInfo) %}
		{% else %}
			{% set listData = query.eagerly().all() %}
		{% endif %}
	
	{% case "selectEntry" %}
		{% set query = listOrder == '' ? entry.entriesToList : entry.entriesToList.orderBy(listOrder) %}
		{% set query = query.with(imgWith) %}
		{% if paginateItems %}
			{% paginate query.limit(entry.itemsPerPage) as pageInfo, listData %}
			{% do seomatic.helper.paginate(pageInfo) %}
		{% else %}
			{% set listData = query.eagerly().all() %}
		{% endif %}
	
	{% case "navList" %}	
		{% set listData = craft.navigation.nodes().handle(entry.navListToDisplay).eagerly().all() %}								
{% endswitch %}

{# content list population #}
{% set siteThumb = gSettings.thumbnailPlaceholder %}
{% for item in listData %}
	{% set itemTitle = item.title ?? null %}
	{% set itemUrl = null %}
	{% set itemTab = false %}
	{% if item.cardLink.value is defined and item.cardLink.value|length %}
		{% set itemUrl = item.cardLink.value %}
		{% set itemTab = item.cardLink.target|length > 0 %}
	{% elseif item.url is defined and item.url|length %}
		{% set itemUrl = item.url %}
		{% set itemTab = item.target.value is defined and item.target|length > 0 %}
	{% endif %}
	{% set itemExcerpt = item.excerpt is defined ? (item.type == 'linkCard' ? item.excerpt|retconChange('a', false) : item.excerpt) : '' %}
	{% set itemImage = item.seoImage|length ? item.seoImage : (item.imageAsset|length ? item.imageAsset : siteThumb) %}
	{% set itemDate = showDate and item.postDate is defined ? item.postDate|date(entry.dateFormat) : '' %}
	{% set listContent = listContent|merge([{'title': itemTitle, 'excerpt': itemExcerpt, 'url': itemUrl, 'newTab': itemTab, 'image': itemImage, 'date': itemDate}]) %}
{% endfor %}

{# begin rendering #}
<div id="{{blockId}}" class="{{blockClass}} @container {{gMacros.displayClasses(entry.display)|spaceless}} {{gMacros.spacingClasses(entry.margins)|spaceless}} {{repeaterClassList|join(' ')}} {{entry.customClasses}}" {{gMacros.attributesOut(entry.customAttributes)|spaceless}}>
	{% if listContent|length %}
		{% set baseContext = {'listContent': listContent, 'headingLvl': entry.headingLevel, 'colorScheme': colorScheme, 'showDate': showDate, 'showExcerpt': showExcerpt} %}
		{% set typeContext = {'textList': {'listStyle': entry.textListStyle, 'multiColSettings': entry.multiColumnSettings}, 'buttonList': {'btnStyles': entry.btnStyles, 'btnOrientation': entry.buttonOrientation, 'horizontalAlignment': entry.horizontalAlignment, 'btnSize': entry.btnSize, 'fullWidthSmall': entry.fullWidthSmall}, 'cardList': {'cardRowSizes': cardRowSizes}, 'cardListSideImage': {'cardRowSizes': cardRowSizes}, 'cardListTopImage': {'cardRowSizes': cardRowSizes}, 'largeSlider': {'sliderButtons': entry.buttons, 'sliderDots': entry.dots, 'sliderTiming': entry.slideTransitionDelay, 'sliderEffect': entry.slideEffect, 'sliderAutoPlay': entry.autoplay, 'sliderSizeSm': entry.sliderSizeSm, 'sliderSizeLg': entry.sliderSizeLg, 'blockId': blockId, 'slideImgAspectSm': slideImgAspectSm ?? null, 'slideImgAspectLg': slideImgAspectLg ?? null}, 'multiCardSlider': {'sliderButtons': entry.buttons, 'sliderDots': entry.dots, 'sliderTiming': entry.slideTransitionDelay, 'sliderEffect': entry.slideEffect, 'sliderAutoPlay': entry.autoplay, 'blockId': blockId, 'cardSliderSizes': cardSliderSizes}} %}
		{% include ['_partials/repeaters/' ~ displayType] with baseContext|merge(typeContext[displayType] ?? {}) %}
		
		{% if paginateItems and pageInfo.totalPages > 1 %}
			{% if entry.showPagination %}
				{% include ['_partials/_boiler/pagination'] %}
			{% elseif entry.fullListingButton and entry.fullListingButton.value|length %}
				<div class="full-listing-btn-wrapper">
					<a href="{{entry.fullListingButton.value}}" class="btn btn-full-listings btn-standard btn-md {{colorScheme}} ">{{entry.fullListingButton.label|length ? entry.fullListingButton.label : 'View Full Listings'}}</a>
				</div>
			{% endif %}
		{% endif %}
	{% else %}
		<div class="list-no-items"><b>No items found.</b></div>
	{% endif %}
</div>