{# Load in global macros for use across all Twig templates #}
{% import '_macros/globalMacros' as gMacros %}


{# Create array for classes to pass to macros for section #}
{% set elementClassList = [entry.artDirection.textWrapDf, entry.artDirection.widthDf] %}
{% set imgClassList = [] %}
{% if entry.artDirection.aspectDf != '' %}
	{% set imgClassList = imgClassList|merge(['aspect-' ~ entry.artDirection.aspectDf]) %}
{% endif %}

{% set image = entry.imageAsset.eagerly().one() %}


{# Set block id attribute value #}
{% if entry.customId is defined and entry.customId != '' %}
	{% set blockId = entry.customId|replace({' ': '-'})|trim %}
{% else %}
	{% set blockId = 'image-' ~ entry.id %}
{% endif %}

{# Set block type handle as class name for styling #}
{% set blockClass = "content-image" %}

{# Set color classes #}
{% if colorScheme is not defined %}
	{% set colorScheme = "color-theme-default" %}	
{% endif %}
{% set colorClasses = [] %}
{% set colorClasses = colorClasses|merge([colorScheme]) %}
{% if entry.textColor|length %}
	{% set colorClasses = colorClasses|merge(['text-' ~ entry.textColor]) %}
{% endif %}
{% if entry.bgColor|length %}
	{% set colorClasses = colorClasses|merge(['bg-' ~ entry.bgColor]) %}
{% endif %}
{% set imgClassList = imgClassList|merge(colorClasses) %}



{# set outer tag depending on if element has caption or not #}
{% if entry.imageCaption != '' %}
	{% set outerTag = 'figure' %}
{% else %}
	{% set outerTag = 'div' %}
{% endif %}


{# SIZING AND STYLING SETUP #}
{% set artDirected  = 0 %}
{% set devSizes = ['df', 'xs', 'sm', 'md', 'lg', 'xl', '2xl'] %}
{% set imgProps = {} %}
{% for size in devSizes %}
	{% set imgProps = imgProps|merge({ (size) : {
		aspect: entry.artDirection['aspect' ~ size|capitalize].value,
		width: entry.artDirection['width' ~ size|capitalize].value,
		wrap: entry.artDirection['textWrap' ~ size|capitalize].value,
	} }) %}
	{% if size != 'df' and entry.artDirection['aspect' ~ size|capitalize].value != '' %}
		{% set artDirected = 1 %}
	{% endif %}
{% endfor %}
{# CSS SET UP FOR ELEMENT #}
{% for size in devSizes %}
	{% if size == 'df' %}
		{% set sizeLabel = '' %}
	{% else %}
		{% set sizeLabel = size ~ ':' %}
	{% endif %}
	{% if imgProps[size].width != '' %}
		{% set elementClassList = elementClassList|merge([sizeLabel ~'w-' ~ imgProps[size].width]) %}
	{% endif %}
	{% if imgProps[size].wrap != '' %}
		{% set elementClassList = elementClassList|merge([sizeLabel ~ imgProps[size].wrap]) %}
	{% endif %}	
{% endfor %}

{# OUTPUT #}
{% if image != null %}
	<{{outerTag}} id="{{blockId}}" class="{{- blockClass }} {{ elementClassList|join(' ') }} {{ gMacros.displayClasses(entry.display, false)}} {{ gMacros.spacingClasses(entry.margins, false) }} {{ entry.customClasses }}" {{- gMacros.attributesOut(entry.customAttributes) }}>
		
		{% if entry.linkSettings!= null %}
			{% if entry.isModalLink %}
				{# modal #}
				{% set modalUrl = '/resources/entrymodal?entryid=' ~ entry.modalLinkSettings.element.id %}
				{% set modalEntry = craft.entries().id(entry.modalLinkSettings.element.id).one() %}
				{% if not craft.app.request.isAjax() %}
					<a id="{{blockId}}-link" x-ref="{{blockId}}-link" type="button" class="img-link {{ entry.linkCustomClasses }}" {% if entry.linkSettings.ariaLabel|length %}aria-label="{{entry.linkSettings.ariaLabel}}"{% endif %} {{- gMacros.attributesOut(entry.linkCustomAttributes) -}}
					
					x-on:click="focusEl='{{blockId}}-link'; $store.contentModal.open('{{modalUrl}}','{{modalEntry.title}}');"				
							 
					>						
				{% elseif modalEntry.section.handle == "pages" %}
					<a href="{{modalEntry.url}}" id="{{blockId}}-link" type="button" class="img-link {{ entry.linkCustomClasses }}" {% if entry.linkSettings.ariaLabel|length %}aria-label="{{entry.linkSettings.ariaLabel}}"{% endif %} {{- gMacros.attributesOut(entry.linkCustomAttributes) -}}>
				{% endif %}			
			{% else %}
				{# everything else #}
				<a href="{{entry.linkSettings.value}}" id="{{blockId}}-link" type="button" class="img-link {{ entry.linkCustomClasses }}" {% if entry.linkSettings.ariaLabel|length %}aria-label="{{entry.linkSettings.ariaLabel}}"{% endif %} {{-  entry.linkSettings.target|length ? ' target="_blank"' : '' }} {{- gMacros.attributesOut(entry.linkCustomAttributes) -}}>
			{% endif %}		
		{% endif %}
		
		{% if image.mimeType == "image/svg+xml" %}		
		
			{# for svg images just drop image in, don't mess with aspect ratio or transforms #}
			<img src="{{ image.url }}" alt="{{entry.altText}}" class="block w-full" loading="{{entry.lazyLoadImg ? 'lazy' : 'eager'}}">
		
		{% else %}		
			{# if entry is art directed, use art direction template if not use regular template #}
			{% if artDirected %}
				{% include '_partials/images/adImage' with {'entry': entry, 'sizeTracker': sizeTracker} %}
			{% else %}
				{% include '_partials/images/regImage' with {'entry': entry, 'sizeTracker': sizeTracker} %}
			{% endif %}
		{% endif %}
		
		{% if entry.linkSettings != null %}
			</a>		
		{% endif %}
		
		{% if entry.imageCaption != '' %}
			<figcaption class="image-caption">
				{{ entry.imageCaption }}						
			</figcaption>				  
		{% endif %}
		
	</{{outerTag}}>
{% endif %}