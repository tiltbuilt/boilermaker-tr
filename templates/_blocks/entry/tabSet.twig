{# Load in global macros for use across all Twig templates #}
{% import '_macros/globalMacros' as gMacros %}

{# Create array for classes to pass to macros for section #}
{% set tabSetClassList = [] %}

{# Set block id attribute value #}
{% if entry.customId is defined and entry.customId != '' %}
	{% set blockId = entry.customId|replace({' ': '-'})|trim %}
{% else %}
	{% set blockId = 'tab-set-' ~ entry.id %}
{% endif %}

{# Set block type handle as class name for styling #}
{% set blockClass = entry.type.handle|kebab %}

{# Set color classes for set #}
{% if colorScheme is not defined %}
	{% set colorScheme = "color-theme-default" %}	
{% endif %}
{% if entry.colorScheme != null %}
	{% set colorScheme = entry.colorScheme.class %}	
{% endif %}

{# Retrieve styling adjustments #}
{% set setPadding = entry.padding %}


{# set default heading level for set #}
{% set setHeaderLevel = entry.headingLevel %}


<!-- Tabs -->

<div
  x-data="{
	selectedId: null,
	init() {
	  // On init, prefer a URL hash that matches a tab button id (if present),
	  // otherwise fall back to the first tab.
	  this.$nextTick(() => {
		const hash = (window.location.hash || '').replace(/^#/, '');
		if (hash) {
		  const target = document.getElementById(hash);
		  // Ensure the found element is one of this tablist's buttons
		  if (target && this.$refs.tablist && this.$refs.tablist.contains(target)) {
			this.select(target.id);
			this.scrollToTarget(target);
			return;
		  }
		}
		this.select(this.$id('tab', 1));
	  });
	},
	scrollToTarget(el) {
	  const top = el.getBoundingClientRect().top + window.scrollY - 50;
	  window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
	},
	select(id) {
	  this.selectedId = id
	},
	isSelected(id) {
	  return this.selectedId === id
	},
	whichChild(el, parent) {
	  return Array.from(parent.children).indexOf(el) + 1
	}
  }"
  x-id="['tab']"
  id="{{blockId}}"
  class="{{- blockClass }} {{ gMacros.displayClasses(entry.display)}} {{ gMacros.spacingClasses(entry.margins) }} {{ tabSetClassList|join(' ') }} {{ entry.customClasses }}" {{- gMacros.attributesOut(entry.customAttributes) }}" >
  <!-- Tab List -->
  <ul
	x-ref="tablist"
	@keydown.right.prevent.stop="$focus.wrap().next()"
	@keydown.home.prevent.stop="$focus.first()"
	@keydown.page-up.prevent.stop="$focus.first()"
	@keydown.left.prevent.stop="$focus.wrap().prev()"
	@keydown.end.prevent.stop="$focus.last()"
	@keydown.page-down.prevent.stop="$focus.last()"
	role="tablist"
	{#class="-mb-px flex items-stretch"#}
	class="tab-list"
  >
  
	{% set tabs = entry.tabs.eagerly().all() %}
	{% for tab in tabs %}
		{% if tab.customId != '' %}
			{% set tabId = tab.customId|replace({' ': '-'})|trim %}
		{% else %}
			{% set tabId = 'tab-' ~ tab.id ~ '-tabSet-' ~ entry.id %}
		{% endif %}
		{# set colors for accordion #}
		{% set colorClasses = [] %}
		{% if tab.colorScheme != null %}
			{% set tabColorScheme = tab.colorScheme.class %}			
		{% else %}
			{% set tabColorScheme = colorScheme %}
		{% endif %}
		{% set colorClasses = colorClasses|merge([tabColorScheme]) %}
	  
	  
			<!-- Tab -->
			<li>
				{% if tab.customId is defined and tab.customId != '' %}
				<button
					id="{{ tabId }}"
					@click="select('{{ tabId }}')"
					@mousedown.prevent
					@focus="select('{{ tabId }}')"
					type="button"
					:tabindex="isSelected('{{ tabId }}') ? 0 : -1"
					:aria-selected="isSelected('{{ tabId }}')"
					:class="isSelected('{{ tabId }}') ? 'tab-active' : ''"
					class="tab-set-btn {{ colorClasses|join(' ') }}"
					role="tab"
				>
				{% else %}
				<button
					:id="$id('tab', whichChild($el.parentElement, $refs.tablist))"
					@click="select($el.id)"
					@mousedown.prevent
					@focus="select($el.id)"
					type="button"
					:tabindex="isSelected($el.id) ? 0 : -1"
					:aria-selected="isSelected($el.id)"
					:class="isSelected($el.id) ? 'tab-active' : ''"
					class="tab-set-btn {{ colorClasses|join(' ') }}"
					role="tab"
				>
				{% endif %}
				{% if tab.icon|length %}
						<div class="tab-icon">
						{% if tab.icon.type == 'svg' %}
								{{ tab.icon.inline }}
						{% elseif tab.icon.type == 'css' %}
								<i class="{{ tab.icon.value }}"></i>                                
						{% else %}
								<svg><use xlink:href="/dist/svg/ui-svg-sprites.svg#{{ tab.icon.value }}"></use></svg>
						{% endif %}
						</div>
				{% endif %}
				<span>{{tab.title}}</span></button>
			</li>
	{% endfor %}      
  </ul> 
  <!-- Panels -->
  <div role="tabpanels" class="tab-panel-wrapper">
	{% for tab in tabs %}
	
		{% set tabClassList = ['tab-panel', tab.textAlignment] %}				
		{% set colorClasses = [] %}		
		
		{# Set tab id attribute value #}
		{% if tab.customId is defined and tab.customId != '' %}
			{% set tabId = tab.customId|replace({' ': '-'})|trim %}
		{% else %}
			{% set tabId = 'tab-' ~ tab.id ~ '-tabSet-' ~ entry.id %}
		{% endif %}
		
		{# set colors for accordion #}
		{% if tab.colorScheme != null %}
			{% set tabColorScheme = tab.colorScheme.class %}			
		{% else %}
			{% set tabColorScheme = colorScheme %}
		{% endif %}
		{% set colorClasses = colorClasses|merge([tabColorScheme]) %}		
		{% set tabClassList = tabClassList|merge(colorClasses) %}
				
					
		{% set tabPadding = tab.padding %}
				
		{# loop through the padding settings  to see if tabs have specific settings and if not, fall back to set setting and add to style list #}
		{% set fLayout = tabPadding.getFieldLayout() %}
		{% for tabObj in fLayout.tabs %}									
			{% for tabEl in tabObj.elements %}
				{% if tabEl.className is same as("craft\\fieldlayoutelements\\CustomField") %}
					{% if tabPadding.getFieldValue(tabEl.field.handle)|length %}
						{% set tabClassList = tabClassList|merge([tabEl.field.handle ~ '-' ~ tabPadding.getFieldValue(tabEl.field.handle)]) %}
					{% elseif setPadding.getFieldValue(tabEl.field.handle)|length %}
						{% set tabClassList = tabClassList|merge([tabEl.field.handle ~ '-' ~ setPadding.getFieldValue(tabEl.field.handle)]) %}
					{% endif %}
				{% endif %}
			{% endfor %}
		{% endfor %}
				
		
	
			<!-- Panel -->
			{% if tab.customId is defined and tab.customId != '' %}
			<div
				x-show="isSelected('{{ tabId }}')"
				aria-labelledby="{{ tabId }}"
				role="tabpanel"
				class=" {{- tabClassList|join(' ') }} {{ gMacros.typeClasses(tab.typeSettings) -}}" {{- gMacros.attributesOut(tab.customAttributes) -}}
			>
			{% else %}
			<div
				x-show="isSelected($id('tab', whichChild($el, $el.parentElement)))"
				:aria-labelledby="$id('tab', whichChild($el, $el.parentElement))"
				role="tabpanel"
				class=" {{- tabClassList|join(' ') }} {{ gMacros.typeClasses(tab.typeSettings) -}}" {{- gMacros.attributesOut(tab.customAttributes) -}}
			>
			{% endif %}
	  <div class="@container">     
		{% for chunk in tab.elementContent %}
			{% if chunk.type == 'markup' %}
				{{chunk|raw|retconAttr(['ul'], { 'class' : 'bullet-list' }, false)|typogrify}}
			{% else %}
				{{ chunk.entry.render({					
					'colorScheme': tabColorScheme,
					'sizeTracker': sizeTracker
				}) }}
			{% endif %}
		{% endfor %}
      </div>
	  </div>
	{% endfor %}          
  </div>
</div>
